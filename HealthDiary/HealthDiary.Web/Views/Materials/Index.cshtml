@model List<HealthDiary.Data.Models.Material>
<h2>Архів матеріалів (Step Lab)</h2>
<p><a asp-action="Create" class="btn btn-success">Додати матеріал</a></p>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Назва</th>
            <th>Колір</th>
            <th>Твердість (Shore)</th>
            <th>Ціна/г</th>
            <th>Дії</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Color</td>
                <td>@item.ShoreHardness</td>
                <td>@item.PricePerGram</td>
                <td><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Редагувати</a></td>
            </tr>
        }
    </tbody>
</table>