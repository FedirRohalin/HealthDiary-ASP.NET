@model HealthDiary.Data.Models.Material
<h2>Новий матеріал</h2>
<form asp-action="Create" method="post" class="w-50">
    <div class="mb-2"><label>Назва</label><input asp-for="Name" class="form-control" required /></div>
    <div class="mb-2"><label>Колір</label><input asp-for="Color" class="form-control" required /></div>
    <div class="mb-2"><label>Твердість (Shore)</label><input asp-for="ShoreHardness" type="number" step="0.1" class="form-control" /></div>
    <div class="mb-2"><label>Ціна за грам</label><input asp-for="PricePerGram" type="number" step="0.01" class="form-control" /></div>
    <div class="mb-3"><label>Температура екструзії</label><input asp-for="ExtrusionTemp" type="number" step="0.1" class="form-control" /></div>
    <button type="submit" class="btn btn-primary">Зберегти</button>
</form>